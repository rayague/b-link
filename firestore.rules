rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==================== HELPER FUNCTIONS ====================
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Comptes anonymes exclus de l'annuaire public (limite l'aspiration).
    function isRealUser() {
      return isSignedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Un utilisateur est admin si un document admins/{uid} existe.
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ==================== USERS (PRIVÉ) ====================
    // Profil complet (email, date avec l'année, heure de naissance...).
    // Jamais lisible par les autres utilisateurs : seule la projection
    // `public_profiles` l'est.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update, delete: if isOwner(userId);

      // Contacts : strictement privés au propriétaire.
      match /contacts/{contactId} {
        allow read, write: if isOwner(userId);
      }

      // Appareils (jetons de notification push) : privés ; lus par les Cloud
      // Functions (Admin SDK) pour prévenir d'un nouveau jumeau.
      match /devices/{token} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['platform', 'locale', 'updatedAt'])
          && request.resource.data.locale in ['fr', 'en'];
      }

      // Profils bloqués : privés, synchronisés entre appareils.
      match /blocks/{blockedId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && blockedId != userId
          && request.resource.data.keys().hasOnly(['name', 'blockedAt']);
      }
    }

    // ==================== PUBLIC PROFILES ====================
    // Projection publique écrite par le propriétaire, uniquement les champs
    // qu'il a choisi de montrer. Le document n'existe que si le profil est
    // public : le supprimer suffit à disparaître de l'annuaire.
    match /public_profiles/{userId} {
      allow get: if isRealUser();
      // Pagination obligatoire pour éviter l'aspiration en une requête.
      allow list: if isRealUser() && request.query.limit <= 50;

      allow create, update: if isOwner(userId)
        // Profil masqué par la modération : pas de republication.
        && !isHiddenByModeration(userId)
        && request.resource.data.keys().hasOnly([
             'uid', 'name', 'birthDayKey', 'birthDate', 'birthTime',
             'birthplace', 'birthCountry', 'birthCity', 'zodiac',
             'socialLinks', 'isPublic', 'publicName', 'publicBirthDate',
             'publicBirthTime', 'publicBirthPlace', 'publicBirthCountry',
             'publicBirthCity', 'publicSocials', 'publicZodiac', 'updatedAt',
             'countryCode', 'publicCountry', 'publicPhoto', 'cityKey'
           ])
        // Pays de résidence : code ISO 3166-1 alpha-2 (filtre "Mon pays").
        && (!('countryCode' in request.resource.data)
            || request.resource.data.countryCode.matches('^[A-Z]{2}$'))
        // Ville : "PAYS:ville normalisée" (filtre "Ma ville").
        && (!('cityKey' in request.resource.data)
            || request.resource.data.cityKey.matches('^[A-Z]{2}:[a-z0-9 ]{1,80}$'))
        && request.resource.data.uid == userId
        && request.resource.data.isPublic == true
        && request.resource.data.birthDayKey is string
        && request.resource.data.birthDayKey.matches('^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');

      allow delete: if isOwner(userId) || isAdmin();
    }

    // ==================== MODERATION ====================
    // moderation/{uid} : décision de modération (masquage de l'annuaire),
    // écrite par la Cloud Function onReportCreated ou par un admin. Le
    // propriétaire peut la lire (pour savoir pourquoi il n'apparaît plus),
    // jamais la modifier.
    function isHiddenByModeration(userId) {
      return exists(/databases/$(database)/documents/moderation/$(userId))
        && get(/databases/$(database)/documents/moderation/$(userId)).data.hidden == true;
    }

    match /moderation/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }

    // ==================== REPORTS ====================
    // Signalements de profils publics : création par un vrai utilisateur en
    // son nom, lecture et traitement réservés aux admins.
    match /reports/{reportId} {
      allow create: if isRealUser()
        && request.resource.data.keys().hasOnly(
             ['reporterUid', 'reportedUid', 'reason', 'createdAt'])
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.reportedUid is string
        && request.resource.data.reportedUid != request.auth.uid
        && request.resource.data.reason in
             ['spam', 'inappropriate', 'fake', 'minor', 'other']
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isAdmin();
    }

    // ==================== ADMINS COLLECTION ====================
    // La création/suppression d'admins se fait côté serveur (Cloud Function /
    // console). Le client peut uniquement lire et mettre à jour sa dernière
    // connexion.
    match /admins/{adminId} {
      allow read: if isOwner(adminId) || isAdmin();

      allow create, delete: if false;

      allow update: if isOwner(adminId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['lastLogin']);
    }

    // ==================== APP STATS ====================
    // Lecture publique (authentifiée) ; écriture réservée au serveur.
    match /app_stats/{document} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Deny everything else by default (sync_queue Firestore, etc.)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
