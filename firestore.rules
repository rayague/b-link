rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==================== USERS COLLECTION ====================
    // Chaque utilisateur peut lire/écrire son propre profil
    match /users/{userId} {
      // Lecture : propriétaire ou si profil public
      allow read: if request.auth != null && (
        request.auth.uid == userId
        || (resource.data.keys().hasAny(['isPublic']) && resource.data.isPublic == true)
      );

      // Création : propriétaire uniquement
      allow create: if request.auth != null && request.auth.uid == userId;

      // Mise à jour : propriétaire uniquement
      allow update: if request.auth != null && request.auth.uid == userId;

      // Suppression : propriétaire uniquement
      allow delete: if request.auth != null && request.auth.uid == userId;

      // ==================== CONTACTS SUBCOLLECTION ====================
      // Les contacts sont privés à chaque utilisateur
      match /contacts/{contactId} {
        // Lecture : propriétaire uniquement
        allow read: if request.auth != null && request.auth.uid == userId;

        // Création : propriétaire uniquement
        allow create: if request.auth != null && request.auth.uid == userId;

        // Mise à jour : propriétaire uniquement
        allow update: if request.auth != null && request.auth.uid == userId;

        // Suppression : propriétaire uniquement
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ==================== APP STATS (ADMIN ONLY) ====================
    // Collection pour les statistiques globales
    match /app_stats/{document} {
      // Lecture : tous les utilisateurs authentifiés
      allow read: if request.auth != null;

      // Écriture : seulement pour le système (via Cloud Functions)
      // Pour l'instant, on permet à tous les utilisateurs authentifiés
      allow write: if request.auth != null;
    }

    // ==================== SYNC QUEUE (Legacy) ====================
    // Pour compatibilité avec l'ancien système
    match /sync_queue/{entry} {
      allow read, write: if request.auth != null;
    }

    match /profiles/{userId} {
      allow read, write: if request.auth != null;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
