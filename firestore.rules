rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==================== HELPER FUNCTIONS ====================
    // Un utilisateur est admin si un document admins/{uid} existe.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ==================== USERS COLLECTION ====================
    // Profil utilisateur + contacts. Le profil sert aussi au "Same Day".
    match /users/{userId} {
      // Lecture : propriétaire, admin, ou profil explicitement public.
      allow read: if request.auth != null && (
        request.auth.uid == userId
        || isAdmin()
        || resource.data.isPublic == true
      );

      // Écriture : propriétaire uniquement.
      allow create, update, delete: if request.auth != null
        && request.auth.uid == userId;

      // Contacts : strictement privés au propriétaire.
      match /contacts/{contactId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ==================== ADMINS COLLECTION ====================
    // La création/suppression d'admins se fait côté serveur (Cloud Function /
    // console). Le client peut uniquement lire et mettre à jour sa dernière
    // connexion.
    match /admins/{adminId} {
      allow read: if request.auth != null && (
        request.auth.uid == adminId
        || isAdmin()
      );

      allow create, delete: if false;

      allow update: if request.auth != null
        && request.auth.uid == adminId
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['lastLogin']);
    }

    // ==================== APP STATS ====================
    // Lecture publique (authentifiée) ; écriture réservée au serveur.
    match /app_stats/{document} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Deny everything else by default (profiles, sync_queue Firestore, etc.)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
